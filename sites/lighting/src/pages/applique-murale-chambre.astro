---
import Layout from "@seo/core/Layout.astro";
import { canonical } from "@seo/core/site";
import { site } from "../site.config";
import { amazonUrl } from "../data/lampes-abordables";
import { bedroomSconces } from "../data/appliques-chambre";

const path = "/applique-murale-chambre";
const title = "Applique murale chambre : 3 modèles bien notés et guide pour bien choisir";
const description = "Applique murale pour la chambre : notre sélection de 3 modèles bien notés, à quelle hauteur la poser, et nos conseils pour choisir le style, l'ampoule et la taille.";
const updated = "novembre 2026";

const faq = [
  {
    q: "À quelle hauteur poser une applique murale dans une chambre ?",
    a: "Au-dessus d'un lit, le bas de l'applique se place le plus souvent entre 1,10 m et 1,40 m du sol, pour que la lumière ne vous éblouisse pas quand vous êtes assis ou allongé. Posez-la d'abord à la main pour tester la position.",
  },
  {
    q: "Faut-il deux appliques ou une seule ?",
    a: "Deux appliques, une de chaque côté du lit, donnent un décor symétrique et un éclairage de lecture pour chacun. Une seule suffit pour une chambre d'une personne ou pour une simple lumière d'ambiance.",
  },
  {
    q: "Quelle ampoule choisir pour une chambre ?",
    a: "Une LED blanc chaud, autour de 2 700 K, pour s'endormir sans lumière trop froide. Pour lire, ajoutez une applique à intensité réglable ou à bras orientable.",
  },
  {
    q: "Une applique murale oblige-t-elle à faire des travaux ?",
    a: "Une applique filaire demande un point de branchement ou une prise. Si vous ne voulez pas d'électricien, regardez les modèles sans fil de notre guide dédié.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: canonical(site, "/") },
      { "@type": "ListItem", position: 2, name: "Applique murale chambre", item: canonical(site, path) },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Sélection d'appliques murales pour la chambre",
    itemListElement: bedroomSconces.map((l, i) => ({ "@type": "ListItem", position: i + 1, name: l.name })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Layout site={site} title={title} description={description} path={path} schema={schema}>
  <nav class="crumbs"><a href="/">Accueil</a> › Applique murale chambre</nav>
  <h1>Applique murale chambre : 3 modèles bien notés et comment bien choisir</h1>
  <p class="meta">Mis à jour en {updated}</p>

  <p class="lead">
    Une applique murale dégage la table de chevet, crée une lumière douce au-dessus du lit et donne du caractère à un mur nu.
    Voici trois modèles bien notés pour une chambre, et ce qu'il faut regarder pour bien la choisir et la poser.
  </p>

  <aside class="tldr">
    <strong>En bref</strong>
    <ul>
      <li>Les trois modèles ci-dessous sont notés 4,1/5 ou plus sur Amazon.</li>
      <li>Au-dessus d'un lit : bas de l'applique entre 1,10 m et 1,40 m du sol.</li>
      <li>Deux appliques, une de chaque côté du lit, pour la symétrie et la lecture.</li>
      <li>Ampoule LED blanc chaud (2 700 K) pour un endormissement tranquille.</li>
    </ul>
  </aside>

  <section aria-labelledby="selection-title">
    <h2 id="selection-title">Notre sélection</h2>
    <p>Nous n'affichons pas les prix, qui changent souvent : vérifiez-les sur la fiche, ainsi que les avis récents.
    Les notes sont celles relevées sur Amazon en {updated}.</p>
    <div class="cards">
      {bedroomSconces.map((p) => (
        <article class="card" id={p.id}>
          <h3>{p.name}</h3>
          <p class="sub">{p.type} · Note Amazon : {p.rating}</p>
          <p>{p.pitch}</p>
          <a class="btn" href={amazonUrl(p.asin)} rel="sponsored nofollow noopener" target="_blank">Voir sur Amazon</a>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="choose-title">
    <h2 id="choose-title">Comment choisir son applique de chambre</h2>
    <ul>
      <li><b>L'usage :</b> pour lire, un bras orientable ou une intensité réglable ; pour l'ambiance, un globe ou un abat-jour diffus.</li>
      <li><b>Le nombre :</b> une paire autour du lit, ou une seule pour un petit espace.</li>
      <li><b>La hauteur :</b> testez la position avant de percer, assis puis allongé.</li>
      <li><b>Le style :</b> industriel, doré ou graphique selon votre décor ; les tons profonds (bordeaux, vert sapin) vont bien avec du laiton.</li>
      <li><b>Le branchement :</b> filaire (prévoir une arrivée) ou sans fil (voir notre guide des appliques sans fil).</li>
    </ul>
  </section>

  <section aria-labelledby="faq-title">
    <h2 id="faq-title">Questions fréquentes</h2>
    {faq.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </section>

  <section class="method">
    <h2>Comment nous choisissons</h2>
    <p>Nous retenons des modèles notés au moins 4/5 sur Amazon et nous ne reprenons que les caractéristiques annoncées sur la fiche.
    Nous ne recevons pas de produits gratuits. Certains liens sont affiliés : cela ne change ni le prix ni notre sélection.</p>
  </section>

  <p><a href="/applique-murale-sans-fil">Voir aussi : l'applique murale sans fil</a> · <a href="/lampe-de-chevet-tactile">la lampe de chevet tactile</a> · <a href="/lampe-de-lecture">la lampe de lecture</a> · <a href="/lampe-tiffany">la lampe Tiffany</a></p>

  <style>
    .crumbs, .meta { font-size: .85rem; color: #6b665e; }
    .lead { font-size: 1.1rem; }
    .tldr { background: #fff; border-left: 4px solid var(--accent); padding: .75rem 1rem; margin: 1.5rem 0; }
    .tldr ul { margin: .5rem 0 0; padding-left: 1.2rem; }
    .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
    .card { background: #fff; border: 1px solid #e4ded5; border-radius: 10px; padding: 1rem; }
    .card h3 { margin: .5rem 0 0; }
    .sub { margin: 0; font-size: .85rem; color: #6b665e; }
    .btn { display: inline-block; background: var(--accent); color: #fff; padding: .5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: 600; }
    details { background: #fff; border: 1px solid #e4ded5; border-radius: 8px; padding: .5rem .8rem; margin: .5rem 0; }
    summary { cursor: pointer; font-weight: 600; }
    .method { font-size: .9rem; color: #4a463f; }
  </style>
</Layout>
