---
import Layout from "@seo/core/Layout.astro";
import { canonical } from "@seo/core/site";
import { site } from "../site.config";
import { amazonUrl } from "../data/lampes-abordables";
import { wirelessSconces } from "../data/appliques-sans-fil";

const path = "/applique-murale-sans-fil";
const title = "Applique murale sans fil : 4 modèles bien notés et guide pour bien choisir";
const description = "Applique murale sans fil, à piles ou rechargeable : notre sélection de 4 modèles bien notés, comment les fixer sans percer ni électricien, et nos conseils pour choisir.";
const updated = "octobre 2026";

const faq = [
  {
    q: "Peut-on poser une applique murale sans fil sans électricien ?",
    a: "Oui : une applique sans fil fonctionne sur batterie ou sur piles, il n'y a donc aucun branchement électrique à faire. Il suffit de la fixer au mur, avec une vis ou un adhésif selon le modèle.",
  },
  {
    q: "Quelle est l'autonomie d'une applique rechargeable ?",
    a: "Elle dépend de la batterie et de l'intensité choisie. Regardez l'autonomie annoncée sur la fiche et lisez les avis récents : une lampe très lumineuse se décharge plus vite.",
  },
  {
    q: "Comment fixer une applique sans percer ?",
    a: "Certains modèles se fixent avec un support adhésif ou magnétique. C'est utile en location, mais vérifiez le poids supporté et la propreté du mur avant de coller.",
  },
  {
    q: "Une applique sans fil peut-elle aller dehors ?",
    a: "Seulement si la fiche l'annonce pour l'extérieur. Cherchez la mention de résistance à l'eau avant de la poser sur une terrasse ou un balcon.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: canonical(site, "/") },
      { "@type": "ListItem", position: 2, name: "Applique murale sans fil", item: canonical(site, path) },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Sélection d'appliques murales sans fil",
    itemListElement: wirelessSconces.map((l, i) => ({ "@type": "ListItem", position: i + 1, name: l.name })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Layout site={site} title={title} description={description} path={path} schema={schema}>
  <nav class="crumbs"><a href="/">Accueil</a> › Applique murale sans fil</nav>
  <h1>Applique murale sans fil : 4 modèles bien notés et comment bien choisir</h1>
  <p class="meta">Mis à jour en {updated}</p>

  <p class="lead">
    Éclairer un mur sans tirer de câble ni appeler un électricien : c'est l'intérêt d'une applique murale sans fil. En location,
    dans une chambre ou au bout d'un couloir, elle se pose en quelques minutes. Voici quatre modèles bien notés et ce qu'il faut regarder
    avant d'acheter.
  </p>

  <aside class="tldr">
    <strong>En bref</strong>
    <ul>
      <li>Les quatre modèles ci-dessous sont notés 4,5/5 ou plus sur Amazon.</li>
      <li>Aucun branchement : batterie ou piles, donc pas d'électricien.</li>
      <li>Regardez l'autonomie annoncée et le mode de recharge (USB-C ou autre).</li>
      <li>Pour l'extérieur, la fiche doit l'annoncer clairement.</li>
    </ul>
  </aside>

  <section aria-labelledby="selection-title">
    <h2 id="selection-title">Notre sélection</h2>
    <p>Nous n'affichons pas les prix, qui changent souvent : vérifiez-les sur la fiche, ainsi que les avis récents.
    Les notes sont celles relevées sur Amazon en {updated}.</p>
    <div class="cards">
      {wirelessSconces.map((p) => (
        <article class="card" id={p.id}>
          <h3>{p.name}</h3>
          <p class="sub">{p.type} · Note Amazon : {p.rating}</p>
          <p>{p.pitch}</p>
          <a class="btn" href={amazonUrl(p.asin)} rel="sponsored nofollow noopener" target="_blank">Voir sur Amazon</a>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="choose-title">
    <h2 id="choose-title">Comment choisir son applique murale sans fil</h2>
    <ul>
      <li><b>Rechargeable ou à piles :</b> rechargeable pour éviter d'acheter des piles, à piles si vous voulez la poser sans prise à proximité pour recharger.</li>
      <li><b>La fixation :</b> vis pour un mur solide, adhésif ou magnétique pour la location.</li>
      <li><b>La commande :</b> télécommande pratique pour un mur placé haut.</li>
      <li><b>La lumière :</b> plusieurs températures de couleur permettent de passer d'une lumière chaude à une lumière plus neutre.</li>
      <li><b>Le style :</b> noir et graphique pour un décor moderne, vintage pour un intérieur ancien.</li>
    </ul>
  </section>

  <section aria-labelledby="faq-title">
    <h2 id="faq-title">Questions fréquentes</h2>
    {faq.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </section>

  <section class="method">
    <h2>Comment nous choisissons</h2>
    <p>Nous retenons des modèles notés au moins 4/5 sur Amazon et nous ne reprenons que les caractéristiques annoncées sur la fiche.
    Nous ne recevons pas de produits gratuits. Certains liens sont affiliés : cela ne change ni le prix ni notre sélection.</p>
  </section>

  <p><a href="/lampe-de-chevet-tactile">Voir aussi : la lampe de chevet tactile</a> · <a href="/lampe-tiffany">la lampe Tiffany</a> · <a href="/lampe-champignon">la lampe champignon</a></p>

  <style>
    .crumbs, .meta { font-size: .85rem; color: #6b665e; }
    .lead { font-size: 1.1rem; }
    .tldr { background: #fff; border-left: 4px solid var(--accent); padding: .75rem 1rem; margin: 1.5rem 0; }
    .tldr ul { margin: .5rem 0 0; padding-left: 1.2rem; }
    .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
    .card { background: #fff; border: 1px solid #e4ded5; border-radius: 10px; padding: 1rem; }
    .card h3 { margin: .5rem 0 0; }
    .sub { margin: 0; font-size: .85rem; color: #6b665e; }
    .btn { display: inline-block; background: var(--accent); color: #fff; padding: .5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: 600; }
    details { background: #fff; border: 1px solid #e4ded5; border-radius: 8px; padding: .5rem .8rem; margin: .5rem 0; }
    summary { cursor: pointer; font-weight: 600; }
    .method { font-size: .9rem; color: #4a463f; }
  </style>
</Layout>
