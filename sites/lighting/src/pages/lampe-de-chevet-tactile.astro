---
import Layout from "@seo/core/Layout.astro";
import { canonical } from "@seo/core/site";
import { site } from "../site.config";
import { amazonUrl } from "../data/lampes-abordables";
import { touchLamps } from "../data/lampes-tactiles";

const path = "/lampe-de-chevet-tactile";
const title = "Lampe de chevet tactile : 5 modèles bien notés et guide pour bien choisir";
const description = "Lampe de chevet tactile, rechargeable ou à cordon : notre sélection de 5 modèles bien notés, comment fonctionne le contrôle tactile, et nos conseils pour choisir.";
const updated = "octobre 2026";

const faq = [
  {
    q: "Comment fonctionne une lampe de chevet tactile ?",
    a: "On touche le pied ou une zone de la lampe pour l'allumer, l'éteindre ou changer l'intensité, sans chercher d'interrupteur dans le noir. Selon les modèles, chaque contact passe d'un niveau de lumière au suivant, ou un contact long règle l'intensité.",
  },
  {
    q: "Faut-il choisir une lampe rechargeable ou à cordon ?",
    a: "Une lampe rechargeable se pose n'importe où et évite le fil qui traîne, mais il faut penser à la recharger et regarder l'autonomie annoncée. Une lampe à cordon n'a pas ce souci, mais elle impose une prise à proximité.",
  },
  {
    q: "Une lampe tactile peut-elle s'allumer toute seule ?",
    a: "Cela peut arriver sur certains modèles bon marché si le capteur est trop sensible ou si la lampe est posée sur un support métallique. Lisez les avis récents sur ce point et posez la lampe sur un support non métallique.",
  },
  {
    q: "Quelle intensité choisir pour lire au lit ?",
    a: "Choisissez un modèle à intensité réglable avec une lumière blanc chaud, autour de 2 700 à 3 000 K. Elle fatigue moins les yeux le soir. Pour lire longtemps, préférez une lampe dont on peut diriger la lumière.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: canonical(site, "/") },
      { "@type": "ListItem", position: 2, name: "Lampe de chevet tactile", item: canonical(site, path) },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Sélection de lampes de chevet tactiles",
    itemListElement: touchLamps.map((l, i) => ({ "@type": "ListItem", position: i + 1, name: l.name })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Layout site={site} title={title} description={description} path={path} schema={schema}>
  <nav class="crumbs"><a href="/">Accueil</a> › Lampe de chevet tactile</nav>
  <h1>Lampe de chevet tactile : 5 modèles bien notés et comment bien choisir</h1>
  <p class="meta">Mis à jour en {updated}</p>

  <p class="lead">
    Allumer sa lampe de chevet d'un simple toucher, sans chercher l'interrupteur dans le noir : c'est l'intérêt d'une lampe tactile.
    Voici cinq modèles bien notés, rechargeables ou à cordon, et ce qu'il faut regarder avant d'acheter.
  </p>

  <aside class="tldr">
    <strong>En bref</strong>
    <ul>
      <li>Les cinq modèles ci-dessous sont notés 4,3/5 ou plus sur Amazon.</li>
      <li>Rechargeable : se pose partout, mais pensez à l'autonomie. À cordon : pas de recharge, mais une prise à proximité.</li>
      <li>Pour lire : intensité réglable, lumière blanc chaud, tête orientable si possible.</li>
      <li>Lisez les avis récents sur la sensibilité du capteur tactile.</li>
    </ul>
  </aside>

  <section aria-labelledby="selection-title">
    <h2 id="selection-title">Notre sélection</h2>
    <p>Nous n'affichons pas les prix, qui changent souvent : vérifiez-les sur la fiche, ainsi que les avis récents.
    Les notes sont celles relevées sur Amazon en {updated}.</p>
    <div class="cards">
      {touchLamps.map((p) => (
        <article class="card" id={p.id}>
          <h3>{p.name}</h3>
          <p class="sub">{p.type} · Note Amazon : {p.rating}</p>
          <p>{p.pitch}</p>
          <a class="btn" href={amazonUrl(p.asin)} rel="sponsored nofollow noopener" target="_blank">Voir sur Amazon</a>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="choose-title">
    <h2 id="choose-title">Comment choisir sa lampe de chevet tactile</h2>
    <ul>
      <li><b>Rechargeable ou cordon :</b> rechargeable pour la liberté de placement, cordon si vous voulez l'oublier.</li>
      <li><b>La taille :</b> sur une table de chevet de moins de 40 cm de large, gardez un petit format.</li>
      <li><b>La lumière :</b> un blanc chaud et une intensité réglable, pour s'endormir sans éblouissement.</li>
      <li><b>Le style :</b> laiton et abat-jour pour un chevet classique, métal pour un décor plus moderne.</li>
    </ul>
  </section>

  <section aria-labelledby="faq-title">
    <h2 id="faq-title">Questions fréquentes</h2>
    {faq.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </section>

  <section class="method">
    <h2>Comment nous choisissons</h2>
    <p>Nous retenons des modèles notés au moins 4/5 sur Amazon et nous ne reprenons que les caractéristiques annoncées sur la fiche.
    Nous ne recevons pas de produits gratuits. Certains liens sont affiliés : cela ne change ni le prix ni notre sélection.</p>
  </section>

  <p><a href="/lampe-tiffany">Voir aussi : la lampe Tiffany</a> · <a href="/lampe-champignon">la lampe champignon</a> · <a href="/lampe-kartell">la lampe Kartell</a> · <a href="/applique-murale-sans-fil">l'applique murale sans fil</a></p>

  <style>
    .crumbs, .meta { font-size: .85rem; color: #6b665e; }
    .lead { font-size: 1.1rem; }
    .tldr { background: #fff; border-left: 4px solid var(--accent); padding: .75rem 1rem; margin: 1.5rem 0; }
    .tldr ul { margin: .5rem 0 0; padding-left: 1.2rem; }
    .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
    .card { background: #fff; border: 1px solid #e4ded5; border-radius: 10px; padding: 1rem; }
    .card h3 { margin: .5rem 0 0; }
    .sub { margin: 0; font-size: .85rem; color: #6b665e; }
    .btn { display: inline-block; background: var(--accent); color: #fff; padding: .5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: 600; }
    details { background: #fff; border: 1px solid #e4ded5; border-radius: 8px; padding: .5rem .8rem; margin: .5rem 0; }
    summary { cursor: pointer; font-weight: 600; }
    .method { font-size: .9rem; color: #4a463f; }
  </style>
</Layout>
