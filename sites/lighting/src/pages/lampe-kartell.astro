---
import Layout from "@seo/core/Layout.astro";
import { canonical } from "@seo/core/site";
import { site } from "../site.config";
import { amazonUrl } from "../data/lampes-abordables";
import { kartellLamps } from "../data/lampes-kartell";

const path = "/lampe-kartell";
const title = "Lampe Kartell : 5 modèles bien notés (Bourgie, Battery, Space) et guide";
const description = "Lampe Kartell Bourgie, Battery, Space ou Mini Planet : notre sélection de 5 modèles bien notés, ce qui les distingue, et nos conseils pour bien choisir et éviter les copies.";
const updated = "octobre 2026";

const faq = [
  {
    q: "Comment reconnaître une vraie lampe Kartell ?",
    a: "Achetez chez un vendeur de confiance : « Expédié par Amazon » ou « Vendu par Kartell » sur la fiche, ou une boutique officielle. Les copies sont très nombreuses sur internet et se vendent bien moins cher. Méfiez-vous d'un prix très bas pour un modèle connu.",
  },
  {
    q: "La lampe Battery fonctionne-t-elle vraiment sans fil ?",
    a: "Oui, c'est une lampe rechargeable : elle n'a pas besoin d'être branchée pour éclairer. Regardez sur la fiche l'autonomie annoncée et le mode de recharge avant d'acheter.",
  },
  {
    q: "Que veut dire « dimmable » ?",
    a: "Une lampe dimmable permet de régler l'intensité de la lumière. C'est pratique pour passer d'un éclairage de lecture à une ambiance tamisée sur une table de chevet ou une console.",
  },
  {
    q: "Une lampe Kartell va-t-elle dans un intérieur ancien ?",
    a: "Oui, c'est même un bon contraste. Un plastique transparent ou coloré posé sur du bois foncé, une cheminée ou des moulures donne un décor moins figé qu'un intérieur tout ancien.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Accueil", item: canonical(site, "/") },
      { "@type": "ListItem", position: 2, name: "Lampe Kartell", item: canonical(site, path) },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Sélection de lampes Kartell",
    itemListElement: kartellLamps.map((l, i) => ({ "@type": "ListItem", position: i + 1, name: l.name })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Layout site={site} title={title} description={description} path={path} schema={schema}>
  <nav class="crumbs"><a href="/">Accueil</a> › Lampe Kartell</nav>
  <h1>Lampe Kartell : 5 modèles bien notés et comment bien choisir</h1>
  <p class="meta">Mis à jour en {updated}</p>

  <p class="lead">
    Kartell, marque italienne née à Milan en 1949, est connue pour ses meubles et ses luminaires en plastique transparent ou coloré.
    Ses lampes Bourgie, Battery, Space ou Mini Planet sont devenues des objets de déco à part entière. Voici cinq modèles bien notés,
    ce qui les distingue, et comment éviter les copies.
  </p>

  <aside class="tldr">
    <strong>En bref</strong>
    <ul>
      <li>Les cinq modèles ci-dessous sont notés 4/5 ou plus sur Amazon.</li>
      <li>Battery : sans fil et rechargeable. Bourgie : le style baroque, ici dimmable.</li>
      <li>Achetez « expédié par Amazon » ou « vendu par Kartell » : les copies sont nombreuses.</li>
      <li>Le plastique transparent contraste bien avec du bois foncé et des murs profonds.</li>
    </ul>
  </aside>

  <section aria-labelledby="selection-title">
    <h2 id="selection-title">Notre sélection</h2>
    <p>Nous n'affichons pas les prix, qui changent souvent : vérifiez-les sur la fiche, ainsi que le vendeur et les avis récents.
    Les notes sont celles relevées sur Amazon en {updated}.</p>
    <div class="cards">
      {kartellLamps.map((p) => (
        <article class="card" id={p.id}>
          <h3>{p.name}</h3>
          <p class="sub">{p.type} · Note Amazon : {p.rating}</p>
          <p>{p.pitch}</p>
          <a class="btn" href={amazonUrl(p.asin)} rel="sponsored nofollow noopener" target="_blank">Voir sur Amazon</a>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="choose-title">
    <h2 id="choose-title">Comment choisir sa lampe Kartell</h2>
    <ul>
      <li><b>Sans fil ou branchée :</b> la Battery se déplace partout ; les autres modèles se branchent sur secteur.</li>
      <li><b>Cristal ou couleur :</b> le transparent se fond dans le décor, la couleur en fait une pièce centrale.</li>
      <li><b>Le style :</b> baroque (Bourgie), graphique (Space), compact (Mini Planet).</li>
      <li><b>Le vendeur :</b> vérifiez toujours qui vend et expédie le produit avant de payer.</li>
    </ul>
  </section>

  <section aria-labelledby="faq-title">
    <h2 id="faq-title">Questions fréquentes</h2>
    {faq.map((f) => (
      <details><summary>{f.q}</summary><p>{f.a}</p></details>
    ))}
  </section>

  <section class="method">
    <h2>Comment nous choisissons</h2>
    <p>Nous retenons des modèles notés au moins 4/5 sur Amazon et nous ne reprenons que les caractéristiques annoncées sur la fiche.
    Nous ne recevons pas de produits gratuits. Certains liens sont affiliés : cela ne change ni le prix ni notre sélection.</p>
  </section>

  <p><a href="/lampe-de-banquier">Voir aussi : notre guide de la lampe de banquier</a> · <a href="/lampe-champignon">la lampe champignon</a></p>

  <style>
    .crumbs, .meta { font-size: .85rem; color: #6b665e; }
    .lead { font-size: 1.1rem; }
    .tldr { background: #fff; border-left: 4px solid var(--accent); padding: .75rem 1rem; margin: 1.5rem 0; }
    .tldr ul { margin: .5rem 0 0; padding-left: 1.2rem; }
    .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
    .card { background: #fff; border: 1px solid #e4ded5; border-radius: 10px; padding: 1rem; }
    .card h3 { margin: .5rem 0 0; }
    .sub { margin: 0; font-size: .85rem; color: #6b665e; }
    .btn { display: inline-block; background: var(--accent); color: #fff; padding: .5rem 1rem; border-radius: 6px; text-decoration: none; font-weight: 600; }
    details { background: #fff; border: 1px solid #e4ded5; border-radius: 8px; padding: .5rem .8rem; margin: .5rem 0; }
    summary { cursor: pointer; font-weight: 600; }
    .method { font-size: .9rem; color: #4a463f; }
  </style>
</Layout>
